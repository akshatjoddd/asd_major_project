generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String?  @default("Admin")
  role         String?  @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookings     Booking[]
}

model TicketType {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  nameHi        String?
  price         Int
  description   String?
  descriptionHi String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings      Booking[]
}

model Exhibition {
  id            Int      @id @default(autoincrement())
  name          String
  nameHi        String?
  description   String
  descriptionHi String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Show {
  id            Int      @id @default(autoincrement())
  name          String
  nameHi        String?
  description   String
  descriptionHi String?
  venue         String?
  venueHi       String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SlotTemplate {
  id          Int      @id @default(autoincrement())
  type        String   @default("entry")
  refId       Int?
  startTime   String
  endTime     String
  capacity    Int      @default(100)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DailyCapacity {
  id          Int      @id @default(autoincrement())
  visitDate   DateTime @unique @db.Date
  capacity    Int
  bookedCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings    Booking[]
}

model Booking {
  id              Int      @id @default(autoincrement())
  bookingCode     String   @unique @default(cuid())

  userId          Int
  ticketTypeId    Int
  dailyCapacityId Int

  quantity        Int
  unitPrice       Int
  totalAmount     Int

  status          String   @default("PENDING_PAYMENT")

  target          String?  @default("entry")
  refId           Int?
  refName         String?
  refNameHi       String?
  date            String?
  slotId          String?
  slotLabel       String?
  itemsJson       String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User          @relation(fields: [userId], references: [id])
  ticketType      TicketType    @relation(fields: [ticketTypeId], references: [id])
  dailyCapacity   DailyCapacity @relation(fields: [dailyCapacityId], references: [id])

  payments        Payment[]
  issuedTickets   IssuedTicket[]

  @@index([userId, createdAt])
  @@index([dailyCapacityId, status])
}

model Payment {
  id                Int      @id @default(autoincrement())
  bookingId         Int

  amount            Int
  status            String   @default("PENDING")

  provider          String   @default("MOCK")
  providerReference String?

  createdAt         DateTime @default(now())
  paidAt            DateTime?

  booking           Booking  @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
}

model IssuedTicket {
  id          Int      @id @default(autoincrement())
  bookingId   Int

  qrToken     String   @unique @default(cuid())
  status      String   @default("VALID")

  issuedAt    DateTime @default(now())
  scannedAt   DateTime?

  booking     Booking  @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
}
